# ──────────────────────────────────────────────────────────────────────────────
# NZ Labour Market Intelligence Platform — Environment Variables
# Copy this to .env and fill in your values. Never commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# Snowflake connection
SNOWFLAKE_ACCOUNT=your_account.ap-southeast-2   # e.g. xy12345.ap-southeast-2
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=ENGINEER_ROLE
SNOWFLAKE_WAREHOUSE=NZ_LABOUR_WH
SNOWFLAKE_DATABASE=NZ_LABOUR_DB
SNOWFLAKE_SCHEMA=RAW

# Data ingestion settings
DATA_DIR=./data/raw                             # Local folder for downloaded CSVs
LOG_LEVEL=INFO

# Notification (optional — for GitHub Actions failure alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
